#!/bin/sh
# Abort commits on main, on ops/local-never-push, and from the primary clone
# (where .git is a directory). Worktrees have a .git FILE and are allowed.
set -e

root=$(git rev-parse --show-toplevel)
branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ] || [ "$branch" = "ops/local-never-push" ]; then
	echo "error: commit forbidden on branch $branch — use a cycle worktree" >&2
	exit 1
fi

if [ -d "$root/.git" ]; then
	echo "error: commit from the primary clone is forbidden; File → Open Folder on a worktree" >&2
	exit 1
fi

# qx-claim espejo: el script canonico vive en Qxchange (cero drift); los
# claims de ESTE repo viven en SU .git (paths relativos por repo).
claim_script="${QX_CLAIM_PS1:-C:/Users/satur/QBANK/Qxchange/scripts/qx-claim.ps1}"
if [ ! -f "$claim_script" ]; then
	echo "error: qx-claim.ps1 is missing ($claim_script); commit is fail-closed" >&2
	exit 1
fi
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$claim_script" -Mode precommit -Clone "$root"

exit 0
