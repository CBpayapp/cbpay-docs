{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CBPay",
  "description": "CBPay developer documentation - fiat payouts and collections across Latin America, internal transfers, on-chain USDT and KYC.",
  "colors": {
    "primary": "#A16207",
    "light": "#FBC140",
    "dark": "#2E2E2E"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#1C1C1C"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "search": {
    "prompt": "Search the docs / Busca en la documentación / 搜索文档…"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "cbpayapp.com",
      "href": "https://cbpayapp.com"
    }
  },
